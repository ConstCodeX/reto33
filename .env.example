# ---- Copy to .env for local dev. In Dokploy, set these as env vars. ----

# Public origin where the app is served. In Dokploy, your domain. No trailing slash.
APP_URL=https://reto33.drcloud.pe

# Secret for sessions/tokens. Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=

# SQLite path — keep on a persistent volume in production.
DATABASE_PATH=/app/data/reto33.db

# OTP delivery: "demo" (shows the code on screen, no emails) or "resend" (real emails).
OTP_DELIVERY=demo

# Only needed when OTP_DELIVERY=resend:
RESEND_API_KEY=
EMAIL_FROM=Reto 33 <onboarding@resend.dev>
